PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dental_clinic_ai?schema=public

# LLM provider — Claude is used when ANTHROPIC_API_KEY is set, otherwise Groq is the fallback.
# If both are empty the engine returns a safe canned reply (no crash).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# RAG — local sentence-transformer embeddings, downloaded once at first run. No API key required.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Optional knowledge-base PDF; falls back to docs/knowledge-base-content.md if absent.
KB_PDF_PATH=../docs/knowledge-base.pdf

# Booking — Cal.com (https://cal.com). The default key is used when no dentist is selected.
CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com/v2
# Per-dentist Cal.com config as a single-line JSON array. serviceEventTypeIds maps each
# service NAME (must match the seeded Service.name) to that dentist's Cal.com event type id.
DENTIST_CALCOM_CONFIGS=[{"dentistName":"Dr. Example","apiKey":"cal_live_xxx","username":"example","timeZone":"Asia/Karachi","serviceEventTypeIds":{"Professional Teeth Cleaning":111111,"Root Canal Therapy":111112,"Dental Implant Consultation":111113}}]

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Voice (Retell)
RETELL_API_KEY=

CORS_ORIGIN=http://localhost:4173,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:5173,https://*.vercel.app
